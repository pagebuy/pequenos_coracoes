{
  // Verificação de tipos do TypeScript: npm run typecheck (não gera arquivos: noEmit).
  // Para escrever em TypeScript, crie arquivos .ts em src/ — o modo estrito vale para eles.
  // checkJs está desligado porque o script.js é JS puro, sem anotações de tipo;
  // mude para true se quiser que o TypeScript também verifique o script.js.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["script.js", "src/**/*.ts"]
}
